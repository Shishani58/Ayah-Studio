41\u043b\u0430\u0431\u043e\u0433\u043e\n+\u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0442\u043e\u043a\u0435\u043d\u0430, \u0435\u0441\u043b\u0438 \u0443\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u0441\u0443\u0444\u0444\u0438\u043a\u0441 \u0442\u043e\u0433\u043e \u0436\u0435 \u0441\u043b\u043e\u0432\u0430 \u0435\u0441\u0442\u044c \u0441\u043f\u0440\u0430\u0432\u0430, \u0430 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0439\n+DSP \u043f\u0440\u043e\u043f\u0443\u0441\u0442\u0438\u043b \u043f\u0430\u0443\u0437\u0443. Crop<=6\u0441, \u0440\u0430\u0437\u0440\u044b\u0432300\u20134000\u043c\u0441; \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u0430\u044f\n+DSP-\u043f\u0440\u0438\u043d\u044f\u0442\u0430\u044f \u043f\u0430\u0443\u0437\u0430 \u0438 \u0441\u043b\u0430\u0431\u043e\u0441\u0442\u044c \u0432\u0441\u0435\u0445 \u043f\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u0442\u043e\u043a\u0435\u043d\u043e\u0432. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f midpoint,\n+confidence/review \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f. \u042d\u0442\u043e DSP \u0431\u0435\u0437 \u043d\u043e\u0432\u044b\u0445 acoustic reads, \u0442\u043e\u043b\u044c\u043a\u043e FULL;\n+trace/source \u0444\u0438\u043a\u0441\u0438\u0440\u0443\u044e\u0442 `qpc-local-weak-prefix-v1`. \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u044b42:1/78:1/89:5 \u0428\u0430\u0442\u0440\u0438;\n+863 \u043d\u0430\u0447\u0430\u043b\u0430:80\u219277 \u0440\u0430\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0439>500\u043c\u0441,0 \u043d\u043e\u0432\u044b\u0445. [\u041f\u0440\u0438\u0447\u0438\u043d\u044b \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430](tasks/2026-10-14-full-accuracy/report.md).\n \u041a\u043e\u043d\u0441\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u043d\u043e\u0435 FULL-\u0440\u0435\u0432\u044c\u044e \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043f\u043e\u043c\u0435\u0447\u0430\u0435\u0442 \u043d\u0435\u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d\u043d\u044b\u0439 \u0437\u0432\u0443\u043a \u043f\u0435\u0440\u0432\u043e\u0433\u043e\n \u0441\u043b\u043e\u0432\u0430 (token confidence<.05) \u0438 \u043f\u043e\u0437\u0434\u043d\u0435\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0432\u043d\u0443\u0442\u0440\u0438 \u0434\u043b\u0438\u043d\u043d\u043e\u0439 \u043f\u0430\u0443\u0437\u044b\n (>=700\u043c\u0441, \u043f\u043e\u0437\u0436\u0435 \u0446\u0435\u043d\u0442\u0440\u0430 \u043d\u0430>200\u043c\u0441). \u042d\u0442\u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u043d\u0435 \u043c\u0435\u043d\u044f\u044e\u0442 \u0432\u0440\u0435\u043c\u044f/confidence,\ndiff --git a/surah_cutter/core/align.py b/surah_cutter/core/align.py\nindex 403f0f3..3d7e117 100644\n--- a/surah_cutter/core/align.py\n+++ b/surah_cutter/core/align.py\n@@ -359,6 +359,7 @@ def align_surah(\n         words, word_token_spans, target_spans, frame_scores, stride_ms, pauses=pauses,\n         lag_ms=getattr(bundle, \"lag_ms\", ALIGN_LAG_MS),\n         ayah_progress=ayah_progress,\n+        pcm=pcm if pause_full else None, sr=sr,\n     )\n     if pause_full:\n         _review_pause_full_onsets(checks.values(), trace[\"full_windows\"])\n@@ -381,6 +382,7 @@ def align_surah(\n                     \"weak-onset\": \"\u043d\u0430\u0447\u0430\u043b\u043e \u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u043e, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0440\u0435\u0432\u044c\u044e\",\n                     \"weak-word\": \"\u0441\u043b\u043e\u0432\u043e \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u043d\u043e \u043d\u0435\u0443\u0432\u0435\u0440\u0435\u043d\u043d\u043e, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0440\u0435\u0432\u044c\u044e\",\n                     \"weak-prefix-across-pause\": \"\u0441\u043b\u0430\u0431\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u043f\u0435\u0440\u0435\u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e \u043f\u043e \u043f\u0430\u0443\u0437\u0435\",\n+                    \"weak-prefix-across-local-pause\": \"\u0441\u043b\u0430\u0431\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u043f\u0435\u0440\u0435\u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043e \u043f\u043e \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u0430\u0443\u0437\u0435\",\n                     \"weak-word-token\": \"\u0437\u0432\u0443\u043a \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043d, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0440\u0435\u0432\u044c\u044e\",\n                     \"late-onset-in-pause\": \"\u0441\u043e\u043c\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0432 \u0434\u043b\u0438\u043d\u043d\u043e\u0439 \u043f\u0430\u0443\u0437\u0435, \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0440\u0435\u0432\u044c\u044e\",\n                 }.get(check[\"reason\"], check[\"reason\"])\n@@ -397,6 +399,7 @@ def _check_ayah_onsets(\n     words, word_token_spans, target_spans, frame_scores, stride_ms,\n     *, pauses, base_ms: float = 0.0, lag_ms: int | None = None,\n     ayah_progress: Any | None = None,\n+    pcm=None, sr: int = EXPECTED_SR,\n ) -> dict[int, dict]:\n     \"\"\"Check first-word evidence without letting blank frames hide weak tokens.\n \n@@ -446,11 +449,34 @@ def _check_ayah_onsets(\n                         if base_ms + sf * stride_ms < p.end_ms\n                     )\n                 ]\n+                local = False\n+                if not supported and pcm is not None and 300 <= strong_ms - first_ms <= 4000:\n+                    # Whole-recording noise percentiles can hide a quiet gap.\n+                    # Recheck only the weak prefix's neighbourhood, with a\n+                    # strict DSP gate; this does not call an acoustic model.\n+                    from surah_cutter.core import candidates\n+\n+                    lo = max(0, round((first_ms - 1000) * sr / 1000))\n+                    hi = min(len(pcm), round((strong_ms + 1000) * sr / 1000))\n+                    offset = lo * 1000 / sr\n+                    for decision in candidates.pause_pipeline_decisions(pcm[lo:hi], sr):\n+                        if not decision.accepted:\n+                            continue\n+                        p = decision.pause\n+                        start, end = offset + p.start_ms, offset + p.end_ms\n+                        if (first_ms < start < end <= strong_ms and all(\n+                            c < 0.25 for (sf, _), c in zip(spans, token_confs)\n+                            if base_ms + sf * stride_ms < end\n+                        )):\n+                            supported.append(candidates.Pause(start, end, end - start))\n+                    local = bool(supported)\n+                    check[\"local_pause_crop_ms\"] = [offset, hi * 1000 / sr]\n                 if len(supported) == 1:\n                     pause = supported[0]\n                     check.update({\n                         \"onset_ms\": round(pause.center_ms), \"repaired\": True,\n-                        \"reason\": \"weak-prefix-across-pause\",\n+                        \"reason\": (\"weak-prefix-across-local-pause\" if local else\n+                                   \"weak-prefix-across-pause\"),\n                         \"pause_start_ms\": pause.start_ms, \"pause_end_ms\": pause.end_ms,\n                     })\n         checks[word.ayah] = check\n@@ -475,7 +501,8 @@ def _full_emissions(bundle: Any, pcm, np, *, trace: dict | None = None) -> Any:\n     from surah_cutter.core import full_windows\n \n     window_trace = {\"algorithm\": full_windows.FULL_POLICY,\n-                    \"review_policy\": full_windows.FULL_REVIEW_POLICY}\n+                    \"review_policy\": full_windows.FULL_REVIEW_POLICY,\n+                    \"onset_policy\": full_windows.FULL_ONSET_POLICY}\n     if trace is not None:\n         trace[\"full_windows\"] = window_trace\n     matrix = full_windows.generate_pause_emissions(\ndiff --git a/surah_cutter/core/align_tiled.py b/surah_cutter/core/align_tiled.py\nindex 0583411..9ebd5e5 100644\n--- a/surah_cutter/core/align_tiled.py\n+++ b/surah_cutter/core/align_tiled.py\n@@ -236,6 +236,7 @@ def align_surah_tiled(\n             checks = A._check_ayah_onsets(\n                 sub_words, spans, tspans, fscores, stride, base_ms=base, pauses=onset_pauses,\n                 lag_ms=lag,\n+                pcm=pcm if parallel_full else None, sr=sr,\n             )\n             for idx, word in enumerate(sub_words):\n                 if idx == 0 or sub_words[idx - 1].ayah != word.ayah:\ndiff --git a/surah_cutter/core/full_windows.py b/surah_cutter/core/full_windows.py\nindex ca91ae7..a442d7f 100644\n--- a/surah_cutter/core/full_windows.py\n+++ b/surah_cutter/core/full_windows.py\n@@ -29,6 +29,7 @@ FULL_WORKERS = 3\n FULL_MAX_WINDOW_S = 60\n FULL_POLICY = \"qpc-full-pause-v1\"\n FULL_REVIEW_POLICY = \"qpc-pause-review-v1\"\n+FULL_ONSET_POLICY = \"qpc-local-weak-prefix-v1\"\n \n \n def detect_strong_pauses(pcm: np.ndarray, *, trace: dict | None = None):\ndiff --git a/surah_cutter/data/alignment_result.py b/surah_cutter/data/alignment_result.py\nindex c0091f2..479487a 100644\n--- a/surah_cutter/data/alignment_result.py\n+++ b/surah_cutter/data/alignment_result.py\n@@ -67,6 +67,8 @@ def result_source(trace: dict[str, Any], requested_mode: str) -> str:\n                    f\":full_max_window_s={full['max_window_s']}\")\n         if full.get(\"review_policy\"):\n             source += f\":full_review_policy={full['review_policy']}\"\n+        if full.get(\"onset_policy\"):\n+            source += f\":full_onset_policy={full['onset_policy']}\"\n     key = trace_run_key(trace)\n     return f\"{source}:fast_run_key={key}\" if key is not None else source\n \n",
