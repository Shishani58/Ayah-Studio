      "total_ms": 59010.625,
      "reference_text": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ الرَّحْمَٰنِ الرَّحِيمِ مَالِكِ يَوْمِ الدِّينِ إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ",
      "reference_ayahs": [
        {
          "ayah": 1,
          "onset_ms": 100,
          "text": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
        },
        {
          "ayah": 2,
          "onset_ms": 6508,
          "text": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ"
        },
        {
          "ayah": 3,
          "onset_ms": 11561,
          "text": "الرَّحْمَٰنِ الرَّحِيمِ"
        },
        {
          "ayah": 4,
          "onset_ms": 16000,
          "text": "مَالِكِ يَوْمِ الدِّينِ"
        },
        {
          "ayah": 5,
          "onset_ms": 21536,
          "text": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ"
        },
        {
          "ayah": 6,
          "onset_ms": 27850,
          "text": "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ"
        },
        {
          "ayah": 7,
          "onset_ms": 33403,
          "text": "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
        }
      ],
